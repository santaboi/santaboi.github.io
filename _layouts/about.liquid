---
layout: default
---
<div class="post">
  <header class="post-header">
    <h1 class="post-title">
      <img
        src="/assets/img/umd_testudo.png"
        alt="Icon"
        class="name-icon"
        style="width: 50px; height: 50px; margin-right: 0px; vertical-align: middle;"
      >
      {% if site.title == 'blank' %}
        <span class="font-weight-bold">{{ site.first_name }}</span> {{ site.middle_name }}
        {{ site.last_name }}
      {% else %}
        {{ site.title }}
      {% endif %}
    </h1>
    <p class="desc">{{ page.subtitle }}</p>
  </header>

  <article>
    {% if page.profile %}
      <div class="profile float-{% if page.profile.align == 'left' %}left{% else %}right{% endif %}">
        {% if page.profile.image %}
          {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
          {% if page.profile.image_circular %}
            {% assign profile_image_class = 'img-fluid z-depth-1 rounded-circle' %}
          {% else %}
            {% assign profile_image_class = 'img-fluid z-depth-1
      rounded' %}
          {% endif %}
          {% capture sizes %}(min-width: {{site.max_width}}) {{ site.max_width | minus: 30 | times: 0.3}}px, (min-width: 576px)
      30vw, 95vw"{% endcapture %}
          {%
            include figure.liquid path = profile_image_path class = profile_image_class sizes = sizes alt = page.profile.image
            cache_bust = true
          %}
        {% endif %}
        {% if page.profile.more_info %}
          <div class="more-info">{{ page.profile.more_info }}</div>
        {% endif %}
      </div>
    {% endif %}

    <div class="clearfix">{{ content }}</div>

    <!-- Selected Experience -->
    <h2>Selected Experience</h2>
    <section class="experience-list" aria-label="Selected experience">
      <article class="experience-item">
        <div class="experience-logo">
          <img src="/assets/img/umd.png" alt="University of Maryland logo">
        </div>
        <div class="experience-details">
          <h3>University of Maryland, College Park</h3>
          <p>M.S. in Computer Science</p>
        </div>
        <p class="experience-date">2024–2026</p>
      </article>

      <article class="experience-item">
        <div class="experience-logo">
          <img src="/assets/img/experiences/ncku.png" alt="National Cheng Kung University logo">
        </div>
        <div class="experience-details">
          <h3>National Cheng Kung University</h3>
          <p>Research Assistant, ACVLab</p>
        </div>
        <p class="experience-date">Jun. 2023–Feb. 2024</p>
      </article>

      <article class="experience-item">
        <div class="experience-logo">
          <img src="/assets/img/experiences/sinica.png" alt="Academia Sinica logo">
        </div>
        <div class="experience-details">
          <h3>Academia Sinica</h3>
          <p>Research Assistant, NLPSA</p>
        </div>
        <p class="experience-date">Jun. 2022–Jun. 2023</p>
      </article>

      <article class="experience-item">
        <div class="experience-logo">
          <img src="/assets/img/experiences/google.png" alt="Google logo">
        </div>
        <div class="experience-details">
          <h3>Google</h3>
          <p>Hardware Product Sprint · Top 3 Product, 2022</p>
        </div>
        <p class="experience-date">Jun.–Sep. 2022</p>
      </article>
    </section>

    <!-- News -->
    {% if page.news and site.announcements.enabled %}
      <h2>
        <a href="{{ '/news/' | relative_url }}" style="color: inherit">News</a>
      </h2>
      {% include news.liquid limit=true %}
    {% endif %}

    <!-- Latest posts -->
    {% if page.latest_posts %}
      {% capture latest_posts_html %}
        {% include latest_posts.liquid %}
      {% endcapture %}
      {% assign latest_posts_html = latest_posts_html | strip %}
      {% unless latest_posts_html == '' %}
        <h2>
          <a href="{{ '/blog/' | relative_url }}" style="color: inherit">Latest Posts</a>
        </h2>
        {{ latest_posts_html }}
      {% endunless %}
    {% endif %}

    <!-- Selected papers -->
    {% if page.selected_papers %}
      <h2>
        <a href="{{ '/publications/' | relative_url }}" style="color: inherit">Selected Publications</a>
      </h2>
      {% include selected_papers.liquid %}
    {% endif %}
    <!-- Social -->
    {% if page.social %}
      <div class="social">
        <div class="contact-icons">{% include social.liquid %}</div>

        <div class="contact-note">{{ site.contact_note }}</div>
      </div>
    {% endif %}
    <!-- Misc. -->
    {% if page.misc %}
      <div style="margin-top: 20px; padding: 20px;">
        <h2>Misc</h2>
        <p>{{ page.misc }}</p>
      </div>
    {% endif %}
  </article>
</div>
